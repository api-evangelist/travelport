        {
          "info": {
            "name": "Shop for ancillaries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.travelport.net/11/air/ancillaryshop/catalogofferingsancillaries"
          },
          "docs": "Shop for ancillaries"
        }
      ]
    }
  ],
  "bundled": true
}