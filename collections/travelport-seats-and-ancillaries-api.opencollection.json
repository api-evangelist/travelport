{
  "opencollection": "1.0.0",
  "info": {
    "name": "Travelport TripServices Flights Booking Seats and Ancillaries API",
    "version": "11"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Seats and Ancillaries",
